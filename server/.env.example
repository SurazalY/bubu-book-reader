# 本文件：server/ 目录的环境变量模板。复制为 server/.env 后只在部署环境填真实值，切勿提交。
# 生效条件：当前工作目录为 server/ 时启动（例如 `cd server && npm run start` 或 `npm run dev`）。
# server/index.js 使用 `import 'dotenv/config'`；dotenv 读取进程当前工作目录下的 .env，
# 因此此时加载的是 server/.env。
# 对外部署推荐在仓库根执行 `npm run server`，那种情况请用仓库根的 .env.example，不要用这一份。
# 两份模板变量集合对齐；DATABASE_PATH 等相对路径须按工作目录填写。

# 整书阅读 AI 后端配置 —— 复制为 .env 并填值
PORT=5191
# 监听地址。未设置时 server/runtime-options.js 默认 127.0.0.1，只接受本机连接。
# 外部机器要访问须显式设为 0.0.0.0（或具体网卡地址）。
# 绑 0.0.0.0 会把服务暴露到所有网卡，应配合反向代理与 HTTPS，不要把开发配置直接用于生产。
HOST=127.0.0.1

# ===== 正式外部 LLM（OpenAI 兼容协议 /v1/chat/completions）=====
# OPENAI_BASE_URL 需要包含 /v1；密钥只放部署环境或未跟踪的本机 .env。
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_ID=
OPENAI_TIMEOUT_MS=30000
OPENAI_PARSE_RETRIES=1

# 相对进程工作目录。从 server/ 启动时用下面这个值；仓库根启动请改为 server/data/readmate.sqlite。
DATABASE_PATH=data/readmate.sqlite
# 至少 32 个字节；只放未跟踪的本机 .env，不要填真实密钥进本模板。
SESSION_TOKEN_SECRET=
SUMMARY_LINK_SIGNING_KEY=
INTERNAL_DEMO_PASSWORD=

# 下面的 AI_* 仅保留给旧版多候选/成本计价适配器；正式外部链路优先使用上面的 OPENAI_*。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_INPUT_COST_MICROS_PER_MILLION=
AI_OUTPUT_COST_MICROS_PER_MILLION=
AI_TIMEOUT_MS=30000

# 前端静态产物目录（相对 server/）；部署时本服务直接 serve 它
DIST_DIR=../dist
PUBLIC_ASSET_DIR=../public
