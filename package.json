{
  "name": "book-reader-app",
  "private": true,
  "version": "1.0.0",
  "description": "读伴前后端一体化阅读与学校权限应用",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "seed:identity": "node server/db/import-seed.js",
    "import:catalog": "node server/db/import-public-domain-catalog.js",
    "import:book-package-v2": "node server/db/import-book-package-v2.js",
    "bootstrap:internal": "node server/db/bootstrap-internal-demo.js",
    "maintenance:reading-monitor-cleanup": "node server/scripts/reading-monitor-cleanup.js",
    "test:frontend": "node --test tests/frontend/*.mjs",
    "test:server": "node --test tests/server/**/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
