{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {
      "enum": ["passed", "failed"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "detail"],
        "properties": {
          "type": {
            "enum": [
              "page-text-mismatch",
              "substantial-omission",
              "cross-page-contamination",
              "duplicate-content",
              "reading-order-error",
              "substantial-addition",
              "text-error"
            ]
          },
          "severity": {
            "enum": ["blocking", "major", "minor"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
