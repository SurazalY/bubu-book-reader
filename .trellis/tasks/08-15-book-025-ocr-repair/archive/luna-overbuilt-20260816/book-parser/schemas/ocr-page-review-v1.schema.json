{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/schemas/ocr-page-review-v1.schema.json",
  "title": "Independent page-scoped OCR review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "bookId", "pageNo", "inputImageSha256", "ocrAttemptSha256", "verdict", "findings", "executionTrace", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "ocr-page-review/v1"},
    "reviewId": {"type": "string", "minLength": 1},
    "bookId": {"const": "book-025"},
    "pageNo": {"type": "integer", "minimum": 1, "maximum": 162},
    "inputImageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ocrAttemptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["passed", "failed"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "detail", "imageEvidence", "ocrEvidence"],
        "properties": {
          "type": {"enum": ["page-text-mismatch", "substantial-omission", "cross-page-contamination", "duplicate-content", "reading-order-error", "substantial-addition"]},
          "severity": {"enum": ["blocking", "major", "minor"]},
          "detail": {"type": "string", "minLength": 1},
          "imageEvidence": {"type": "string", "minLength": 1},
          "ocrEvidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "executionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "model", "mode", "sandbox"],
      "properties": {
        "system": {"const": "agy"},
        "model": {"const": "gemini-3.7-flash-high"},
        "mode": {"const": "plan"},
        "sandbox": {"const": true},
        "conversationId": {"type": "string", "minLength": 1}
      }
    },
    "createdAt": {"type": "string", "minLength": 1}
  }
}
